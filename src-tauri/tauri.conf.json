{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小小清单",
  "version": "0.1.1",
  "identifier": "com.redhorizon.todolist",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "小小清单", "width": 1120, "height": 780, "minWidth": 860, "minHeight": 620, "resizable": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "Productivity",
    "shortDescription": "简单记录每一件要完成的事",
    "longDescription": "一个简洁、私密的待办清单和备忘录应用。",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true
      }
    }
  }
}
