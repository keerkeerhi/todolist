{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Red Horizon",
  "version": "0.1.0",
  "identifier": "com.redhorizon.todolist",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Red Horizon", "width": 1120, "height": 780, "minWidth": 860, "minHeight": 620, "resizable": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "Productivity",
    "shortDescription": "A calm place for your next adventure",
    "longDescription": "A private todolist and memo app with a red horizon spirit.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true
      }
    }
  }
}
